# VoxMed Server Configurations
PORT=5000

# MongoDB Atlas URI (Optional - if left blank, falls back to local JSON database)
MONGODB_URI=mongodb+srv://voxmed:voxmed123@cluster0.cq0h6uh.mongodb.net/?appName=Cluster0

# Gemini API Key (Optional - if left blank, falls back to mock clinical rules-based AI processing)
