# ==============================================================================
# VoxMed Full-Stack Project - Production-Ready Git Ignore Configuration
# ==============================================================================
# This configuration protects the repository from committing sensitive credentials
# (like Gemini API keys, MongoDB URIs, and passwords), dependency packages,
# build artifacts, temporary log files, and editor settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CRITICAL: Security & Environment Credentials
# ------------------------------------------------------------------------------
# Strictly ignore environment configuration files where API keys, passwords,
# and MongoDB connection strings are stored. NEVER commit these files.
.env
.env.local
.env.development
.env.production
.env.test
.env.staging
*.env
*.env.*
.env*.local

# Backend-specific environment configurations
backend/.env
backend/.env.local
backend/.env.development
backend/.env.production

# Frontend-specific environment configurations
frontend/.env
frontend/.env.local
frontend/.env.development
frontend/.env.production

# ------------------------------------------------------------------------------
# 2. Dependencies (Node Package Manager directories)
# ------------------------------------------------------------------------------
# Packages should be installed locally via package managers, not tracked in git.
node_modules/
backend/node_modules/
frontend/node_modules/

# ------------------------------------------------------------------------------
# 3. Production Builds, Bundles, and Compilations
# ------------------------------------------------------------------------------
# Distribution and build outputs from React, Vite, and other bundlers.
dist/
build/
coverage/
.cache/
.parcel-cache/
.vercel/
.next/

# Frontend-specific distribution output
frontend/dist/

# ------------------------------------------------------------------------------
# 4. Database Backups & Temporary Storage
# ------------------------------------------------------------------------------
# Ignore database backups containing MongoDB data or other developer dumps.
backend/data/*.backup.json
tmp/
temp/

# ------------------------------------------------------------------------------
# 5. Diagnostics, Logs, & Debug Files
# ------------------------------------------------------------------------------
# Log files generated by runtime environments or package managers.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 6. IDE, Code Editor, and OS Specific Files
# ------------------------------------------------------------------------------
# Editor settings and operating system metadata.
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
